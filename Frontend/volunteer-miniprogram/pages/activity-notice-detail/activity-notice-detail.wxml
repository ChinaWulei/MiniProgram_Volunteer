<view class="page" wx:if="{{detail}}">
  <view class="label">{{detail.typeLabel}}</view>
  <view class="title">{{detail.title}}</view>
  <view class="time">{{detail.createdAtText}}</view>
  <view class="content">{{detail.content}}</view>

  <image class="pic" wx:for="{{detail.images}}" wx:key="ruleFileId" src="{{item.url}}" mode="widthFix"
    bindtap="previewImage" data-url="{{item.url}}" />

  <view class="files" wx:if="{{detail.files.length}}">
    <view class="section-title">附件</view>
    <view class="file-row" wx:for="{{detail.files}}" wx:key="ruleFileId" bindtap="openAttachment" data-url="{{item.url}}">
      <view class="file-name">{{item.fileName}}</view>
      <view class="muted">{{item.fileType}} · 点击打开附件</view>
    </view>
  </view>
</view>
