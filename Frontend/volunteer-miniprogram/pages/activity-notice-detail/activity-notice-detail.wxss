.page { min-height: 100vh; padding: 32rpx; background: #fff; box-sizing: border-box; }
.label { display: inline-flex; align-items: center; height: 48rpx; padding: 0 18rpx; border-radius: 24rpx; color: #0f766e; background: #eefaf7; font-size: 22rpx; font-weight: 700; }
.title { margin-top: 22rpx; color: #101828; font-size: 40rpx; font-weight: 800; line-height: 1.35; }
.time { margin-top: 12rpx; color: #667085; font-size: 24rpx; }
.content { margin-top: 30rpx; color: #344054; font-size: 30rpx; line-height: 1.75; white-space: pre-wrap; }
.pic { width: 100%; margin-top: 22rpx; border-radius: 12rpx; background: #f2f4f7; }
.files { margin-top: 32rpx; }
.section-title { margin-bottom: 14rpx; color: #101828; font-weight: 800; }
.file-row { margin-bottom: 14rpx; padding: 22rpx; border-radius: 12rpx; background: #f6f8fb; }
.file-name { color: #101828; font-weight: 700; word-break: break-all; }
.muted { margin-top: 6rpx; color: #667085; font-size: 24rpx; }
