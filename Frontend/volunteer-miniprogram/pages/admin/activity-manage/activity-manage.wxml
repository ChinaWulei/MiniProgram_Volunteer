<view class="manage-page">
  <view class="header">
    <view>
      <view class="kicker">管理员</view>
      <view class="title">活动管理</view>
    </view>
    <button class="publish-btn" bindtap="publish">发布活动</button>
  </view>

  <view class="filter-card">
    <input placeholder="搜索活动标题" value="{{keyword}}" bindinput="input" confirm-type="search" bindconfirm="load" />
    <view class="filter-row">
      <picker mode="selector" range="{{statuses}}" bindchange="pickStatus">
        <view class="filter-chip">状态：{{status || '全部'}}</view>
      </picker>
      <button class="search-btn" bindtap="load">筛选</button>
    </view>
  </view>

  <view class="activity-card" wx:for="{{list}}" wx:key="id">
    <image wx:if="{{item.coverImageUrl}}" class="cover" src="{{item.coverImageUrl}}" mode="aspectFill"></image>
    <view wx:else class="cover placeholder">志愿服务</view>
    <view class="card-main">
      <view class="row">
        <view class="activity-title">{{item.title}}</view>
        <view class="status">{{item.status}}</view>
      </view>
      <view class="meta">{{item.category}} · {{item.location}}</view>
      <view class="meta">{{item.timeText}}</view>
      <view class="meta">招募 {{item.recruitNumber}} 人 · 申请 {{item.applicantNumber || 0}} 人 · 已录取 {{item.registeredNumber}} 人</view>
      <view class="actions">
        <button bindtap="detail" data-id="{{item.id}}">详情</button>
        <button class="edit" bindtap="edit" data-id="{{item.id}}">编辑</button>
        <button bindtap="checkin" data-id="{{item.id}}">签到</button>
        <button bindtap="feedback" data-id="{{item.id}}">评价</button>
        <button bindtap="openNotice" data-id="{{item.id}}">通知</button>
        <button bindtap="finish" data-id="{{item.id}}">结束</button>
        <button wx:if="{{item.status === '已结束'}}" bindtap="summary" data-id="{{item.id}}">总结</button>
        <button class="danger" bindtap="remove" data-id="{{item.id}}">删除</button>
      </view>
    </view>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty">暂无活动</view>

  <view wx:if="{{showSummary}}" class="mask" bindtap="closeSummary"></view>
  <view wx:if="{{showSummary}}" class="summary-panel">
    <view class="summary-title">活动总结</view>
    <scroll-view scroll-y class="summary-scroll">
      <text class="summary-text">{{summaryText}}</text>
    </scroll-view>
    <view class="summary-actions">
      <button bindtap="closeSummary">关闭</button>
      <button class="edit" bindtap="copySummary">复制</button>
    </view>
  </view>

  <view wx:if="{{showFeedback}}" class="mask" bindtap="closeFeedback"></view>
  <view wx:if="{{showFeedback}}" class="feedback-panel" catchtap="stopTap">
    <view class="feedback-head">
      <view>
        <view class="summary-title">志愿者评价</view>
        <view class="feedback-activity">{{feedbackActivityName}}</view>
      </view>
      <button class="close-btn" bindtap="closeFeedback">关闭</button>
    </view>

    <view class="feedback-stats">
      <view><text class="stat-number">{{feedbackAverage}}</text><text class="stat-unit"> / 5 分</text></view>
      <view class="stat-count">共 {{feedbackCount}} 条评价</view>
    </view>

    <button class="ai-summary-btn" disabled="{{feedbackCount === 0 || aiSummaryLoading}}" bindtap="generateFeedbackSummary">
      {{aiSummaryLoading ? 'AI 正在总结...' : '生成 AI 评价总结'}}
    </button>

    <view wx:if="{{aiFeedbackSummary}}" class="ai-summary-box">
      <view class="ai-summary-title">AI 总结</view>
      <text>{{aiFeedbackSummary}}</text>
    </view>

    <scroll-view scroll-y class="feedback-scroll">
      <view wx:for="{{feedbackList}}" wx:key="id" class="feedback-item">
        <view class="feedback-row">
          <view class="feedback-user">{{item.evaluatorName || '志愿者'}}</view>
          <view class="feedback-score">{{item.score}} 分</view>
        </view>
        <view class="feedback-target">评价对象：{{item.targetText}} · {{item.createdText}}</view>
        <view class="feedback-content">{{item.contentText}}</view>
      </view>
      <view wx:if="{{feedbackList.length === 0}}" class="feedback-empty">暂无志愿者评价</view>
    </scroll-view>
  </view>

  <view wx:if="{{showNotice}}" class="mask" bindtap="closeNotice"></view>
  <view wx:if="{{showNotice}}" class="notice-panel" catchtap="stopTap">
    <view class="summary-title">发布活动通知</view>
    <view class="notice-activity">{{noticeActivity.title || noticeActivity.name}}</view>
    <input placeholder="通知标题" value="{{noticeForm.title}}" data-key="title" bindinput="inputNotice" maxlength="60" />
    <textarea placeholder="请输入要发送给该活动志愿者的通知内容，例如集合地点变更、物资准备、活动流程提醒等" value="{{noticeForm.content}}" data-key="content" bindinput="inputNotice" maxlength="400"></textarea>
    <picker mode="selector" range="{{noticeScopes}}" range-key="label" value="{{noticeScopeIndex}}" bindchange="pickNoticeScope">
      <view class="notice-scope">接收范围：{{noticeScopeLabel}}</view>
    </picker>
    <view class="notice-actions">
      <button bindtap="closeNotice">取消</button>
      <button class="edit" bindtap="sendNotice" loading="{{noticeSending}}">发送</button>
    </view>
  </view>
</view>
