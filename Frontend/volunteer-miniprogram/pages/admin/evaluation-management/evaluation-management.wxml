<view class="page">
  <view class="filter">
    <input placeholder="搜索活动" value="{{keyword}}" bindinput="inputKeyword" />
    <button bindtap="loadActivities">搜索</button>
  </view>

  <view class="activity" wx:for="{{activities}}" wx:key="id">
    <view class="activity-main">
      <view class="title">{{item.name}}</view>
      <view class="meta">{{item.category}} · {{item.status}} · {{item.evaluationCount || 0}} 条评价</view>
    </view>
    <button class="view-btn" bindtap="selectActivity" data-id="{{item.id}}" data-name="{{item.name}}">查看评价</button>
  </view>

  <view wx:if="{{currentId}}" class="panel">
    <view class="panel-title">{{currentName}} · 活动反馈均分 {{averageScore}} · 共 {{feedback.length}} 条评价</view>
    <button class="primary" bindtap="summary" loading="{{summaryLoading}}">生成AI评价总结</button>
    <view wx:if="{{summaryText}}" class="summary">{{summaryText}}</view>

    <view class="feedback" wx:for="{{feedback}}" wx:key="id">
      <view class="row"><text>{{item.evaluatorName}}</text><text>{{item.score}}分</text></view>
      <view class="target">评价对象：{{item.targetText}}</view>
      <view class="content">{{item.content}}</view>
      <view wx:if="{{item.canAdopt}}" class="ai">活动评价内容：{{item.parsedOverall || '无'}}&#10;活动优点：{{item.parsedAdvantages || '无'}}&#10;活动不足：{{item.parsedProblems || '无'}}&#10;改进建议：{{item.parsedSuggestions || '无'}}</view>
      <view wx:else class="admin-evaluation-tip">这是管理员对志愿者的履约评价。</view>
    </view>

    <view wx:if="{{feedback.length === 0}}" class="empty">该活动暂无志愿者评价</view>
  </view>
</view>
