<view class="page">
  <view class="filter"><input placeholder="搜索活动" value="{{keyword}}" bindinput="inputKeyword" /><button bindtap="loadActivities">搜索</button></view>
  <view class="activity" wx:for="{{activities}}" wx:key="id">
    <view bindtap="selectActivity" data-id="{{item.id}}" class="title">{{item.name}}</view>
    <view class="meta">{{item.category}} · {{item.status}}</view>
  </view>
  <view wx:if="{{currentId}}" class="panel">
    <view class="panel-title">评价明细 · 平均 {{averageScore}} 分 · {{feedback.length}} 条</view>
    <button class="primary" bindtap="summary" loading="{{summaryLoading}}">生成AI评价总结</button>
    <view wx:if="{{summaryText}}" class="summary">{{summaryText}}</view>
    <view class="feedback" wx:for="{{feedback}}" wx:key="id">
      <view class="row"><text>{{item.evaluatorName}}</text><text>{{item.score}}分</text></view>
      <view class="content">{{item.content}}</view>
      <view class="ai">活动评价内容：{{item.parsedOverall || '无'}}&#10;活动优点：{{item.parsedAdvantages || '无'}}&#10;活动不足：{{item.parsedProblems || '无'}}&#10;改进建议：{{item.parsedSuggestions || '无'}}</view>
      <view class="actions">
        <button bindtap="adopt" data-id="{{item.id}}" data-type="ADVANTAGE">采纳优秀反馈</button>
        <button bindtap="adopt" data-id="{{item.id}}" data-type="SUGGESTION">采纳建议</button>
        <button bindtap="unadopt" data-id="{{item.id}}" data-type="SUGGESTION">取消采纳</button>
      </view>
    </view>
  </view>
</view>
