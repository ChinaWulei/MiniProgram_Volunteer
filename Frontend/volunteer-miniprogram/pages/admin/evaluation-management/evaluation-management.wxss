.page { min-height: 100vh; padding: 24rpx; background: #f5f7fb; }
.filter { display: flex; gap: 12rpx; align-items: center; }
.filter input { flex: 1; height: 68rpx; padding: 0 18rpx; border-radius: 14rpx; background: #fff; box-sizing: border-box; }
.filter button { flex: 0 0 112rpx; width: 112rpx; height: 58rpx; line-height: 58rpx; margin: 0; padding: 0; border-radius: 14rpx; color: #fff; background: #0f766e; font-size: 24rpx; text-align: center; }
.primary { width: 240rpx; height: 62rpx; line-height: 62rpx; margin: 16rpx 0 0; padding: 0; border-radius: 14rpx; color: #fff; background: #0f766e; font-size: 24rpx; text-align: center; }
.activity-card, .panel, .feedback, .empty { margin-top: 18rpx; padding: 20rpx; border-radius: 18rpx; background: #fff; }
.activity { display: flex; align-items: center; gap: 14rpx; }
.activity-card .panel { margin-top: 16rpx; padding: 18rpx; background: #f8fafc; }
.activity-main { flex: 1; min-width: 0; }
.title, .panel-title { color: #172033; font-size: 29rpx; font-weight: 800; }
.meta { margin-top: 8rpx; color: #667085; font-size: 23rpx; }
.view-btn { flex: 0 0 150rpx; width: 150rpx; height: 58rpx; line-height: 58rpx; margin: 0; padding: 0; border-radius: 14rpx; color: #fff; background: #0f766e; font-size: 23rpx; }
.row { display: flex; justify-content: space-between; font-weight: 800; }
.target { margin-top: 8rpx; color: #667085; font-size: 22rpx; }
.content { margin-top: 12rpx; color: #344054; font-size: 25rpx; line-height: 1.6; }
.ai, .summary { margin-top: 12rpx; padding: 14rpx; border-radius: 14rpx; color: #0f766e; background: #f0fdfa; font-size: 23rpx; line-height: 1.7; white-space: pre-wrap; }
.summary-title { margin-bottom: 8rpx; font-weight: 800; color: #0f766e; }
.summary-line { display: flex; align-items: flex-start; gap: 8rpx; padding: 6rpx 0; }
.dot { flex: 0 0 20rpx; color: #0f766e; font-weight: 800; }
.line-text { flex: 1; min-width: 0; color: #344054; }
.admin-evaluation-tip { margin-top: 12rpx; padding: 14rpx; border-radius: 14rpx; color: #667085; background: #f2f4f7; font-size: 22rpx; }
.actions { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.actions button { width: auto; height: 54rpx; line-height: 54rpx; margin: 0; padding: 0 16rpx; border-radius: 14rpx; color: #0f766e; background: #eefaf7; font-size: 22rpx; }
.empty { color: #98a2b3; text-align: center; }
