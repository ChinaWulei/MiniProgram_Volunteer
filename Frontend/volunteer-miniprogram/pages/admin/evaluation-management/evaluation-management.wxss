.page{min-height:100vh;padding:24rpx;background:#f5f7fb}.filter{display:flex;gap:12rpx}.filter input{flex:1;background:#fff;border-radius:14rpx;padding:0 18rpx}.filter button,.primary{background:#0f766e;color:#fff;border-radius:14rpx}.activity,.panel,.feedback{margin-top:18rpx;padding:20rpx;border-radius:18rpx;background:#fff}.title,.panel-title{font-size:29rpx;font-weight:800;color:#172033}.meta{margin-top:8rpx;color:#667085;font-size:23rpx}.row{display:flex;justify-content:space-between;font-weight:800}.content{margin-top:12rpx;color:#344054;font-size:25rpx;line-height:1.6}.ai,.summary{margin-top:12rpx;padding:14rpx;border-radius:14rpx;background:#f0fdfa;color:#0f766e;font-size:23rpx;line-height:1.7;white-space:pre-wrap}.actions{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:12rpx}.actions button{width:auto;margin:0;padding:0 16rpx;height:54rpx;line-height:54rpx;color:#0f766e;background:#eefaf7;font-size:22rpx;border-radius:14rpx}
