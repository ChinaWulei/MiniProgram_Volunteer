<view class="page">
  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="title">{{item.activityName}} · {{item.volunteerName}}</view>
    <view class="content">{{item.content}}</view>
    <view class="ai">主要收获：{{item.parsedGain || '无'}}&#10;能力成长：{{item.parsedAbility || '无'}}&#10;经验总结：{{item.parsedExperience || '无'}}&#10;给后来者的建议：{{item.parsedAdvice || '无'}}</view>
    <button bindtap="recommend" data-id="{{item.id}}" data-recommended="{{!item.recommended}}">{{item.recommended ? '取消推荐' : '推荐为优秀感悟'}}</button>
  </view>
</view>
