<view class="page">
  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="title">{{item.activityName}} · {{item.volunteerName}}</view>
    <view class="status">{{item.displayEnabled ? '活动详情页可展示' : '未展示'}}</view>
    <view class="content">{{item.content}}</view>
    <view class="ai">主要收获：{{item.parsedGain || '无'}}&#10;能力成长：{{item.parsedAbility || '无'}}&#10;参与经验：{{item.parsedExperience || '无'}}&#10;给后续志愿者的建议：{{item.parsedAdvice || '无'}}</view>
    <view class="actions">
      <button bindtap="setDisplay" data-id="{{item.id}}" data-enabled="{{!item.displayEnabled}}">{{item.displayEnabled ? '取消展示' : '允许展示'}}</button>
      <button class="danger" bindtap="remove" data-id="{{item.id}}">删除</button>
    </view>
  </view>
  <view wx:if="{{list.length === 0}}" class="empty">暂无成长感悟</view>
</view>
