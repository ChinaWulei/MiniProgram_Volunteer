.page{min-height:100vh;padding:24rpx;background:#f5f7fb}
.card,.empty{margin-bottom:18rpx;padding:22rpx;border-radius:18rpx;background:#fff}
.title{font-size:28rpx;font-weight:800;color:#172033}
.status{display:inline-flex;margin-top:10rpx;padding:6rpx 14rpx;border-radius:999rpx;color:#0f766e;background:#e6fffb;font-size:22rpx}
.content{margin-top:12rpx;color:#344054;font-size:26rpx;line-height:1.6}
.ai{margin-top:14rpx;padding:16rpx;border-radius:14rpx;background:#f0fdfa;color:#0f766e;font-size:24rpx;line-height:1.7;white-space:pre-wrap}
.actions{display:flex;gap:12rpx;margin-top:14rpx}
button{flex:1;margin:0;background:#0f766e;color:#fff;border-radius:14rpx}
.danger{background:#dc2626}
.empty{text-align:center;color:#98a2b3}
