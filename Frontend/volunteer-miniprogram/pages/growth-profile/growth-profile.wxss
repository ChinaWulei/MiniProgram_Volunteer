.page{min-height:100vh;padding:24rpx;background:#f5f7fb}.hero{padding:32rpx;border-radius:22rpx;color:#fff;background:linear-gradient(135deg,#0f766e,#14b8a6)}.title{font-size:38rpx;font-weight:900}.sub{margin-top:10rpx;font-size:25rpx;opacity:.9}.card{margin-top:18rpx;padding:22rpx;border-radius:18rpx;background:#fff}.section-title{font-size:29rpx;font-weight:800;color:#172033}.section-title.small{margin-top:18rpx}.content{margin-top:12rpx;color:#344054;font-size:26rpx;line-height:1.65}.pre{white-space:pre-wrap}.tag{display:inline-block;margin:12rpx 10rpx 0 0;padding:8rpx 16rpx;border-radius:999rpx;background:#ecfdf5;color:#0f766e;font-size:23rpx}.muted{margin-top:10rpx;color:#98a2b3}.ai{margin-top:14rpx;padding:16rpx;border-radius:14rpx;background:#f0fdfa;color:#0f766e;font-size:24rpx;line-height:1.7;white-space:pre-wrap}.primary{margin-top:18rpx;background:#0f766e;color:#fff;border-radius:16rpx}
