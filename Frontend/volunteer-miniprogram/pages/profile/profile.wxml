<view class="profile-page">
  <view class="profile-header">
    <view class="avatar-wrap" bindtap="chooseAvatar">
      <image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar default-avatar">{{avatarText}}</view>
      <view class="avatar-tip">更换</view>
    </view>
    <view class="profile-main">
      <view class="nickname">{{profile.nicknameText}}</view>
      <view class="meta">编号 {{profile.volunteerNo || '-'}}</view>
      <view class="meta">{{profile.collegeText}} · {{profile.majorClassText}}</view>
    </view>
  </view>

  <view class="growth-card">
    <view class="level-row">
      <view>
        <view class="level">{{profile.volunteerLevelText}} {{profile.levelNameText}}</view>
        <view class="level-sub" wx:if="{{profile.nextLevelHours}}">距离下一等级还需 {{profile.nextLevelRemainingHours}} 小时</view>
        <view class="level-sub" wx:else>已达到最高等级</view>
      </view>
      <view class="points">{{profile.volunteerPoints || 0}} 积分</view>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{profile.levelProgress || 0}}%;"></view>
    </view>
    <view class="stat-grid">
      <view class="stat-item"><view class="stat-num">{{profile.totalHours || 0}}</view><view class="stat-label">服务时长</view></view>
      <view class="stat-item"><view class="stat-num">{{profile.volunteerPoints || 0}}</view><view class="stat-label">志愿积分</view></view>
      <view class="stat-item"><view class="stat-num">{{profile.campusRank || '-'}}</view><view class="stat-label">校园排名</view></view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">信用档案</view>
    <view class="info-row"><text>信用分</text><text>{{profile.creditScore || 100}} 分 · {{profile.creditLevel || '优秀'}}</text></view>
    <view class="credit-record" wx:for="{{profile.creditRecords}}" wx:key="id">
      <view>
        <view class="credit-reason">{{item.reason}}</view>
        <view class="credit-time">{{item.createdText}}</view>
      </view>
      <view class="credit-change {{item.changeValue < 0 ? 'minus' : 'plus'}}">{{item.changeText}}</view>
    </view>
    <view wx:if="{{!profile.creditRecords || profile.creditRecords.length === 0}}" class="empty-badge">暂无扣分记录</view>
  </view>

  <view class="section">
    <view class="section-title">勋章墙</view>
    <view class="badge-grid" wx:if="{{profile.badges && profile.badges.length}}">
      <view class="badge" wx:for="{{profile.badges}}" wx:key="*this">
        <view class="badge-icon">✓</view>
        <view class="badge-name">{{item}}</view>
      </view>
    </view>
    <view class="empty-badge" wx:else>完成报名和服务后会点亮勋章</view>
  </view>

  <view class="section">
    <view class="section-title">基础资料</view>
    <view wx:if="{{!editing}}">
      <view class="info-row"><text>昵称</text><text>{{profile.nicknameText}}</text></view>
      <view class="info-row"><text>学院</text><text>{{profile.collegeText}}</text></view>
      <view class="info-row"><text>所在校区</text><text>{{profile.campusText}}</text></view>
      <view class="info-row"><text>所属系</text><text>{{profile.departmentText}}</text></view>
      <view class="info-row"><text>专业班级</text><text>{{profile.majorClassText}}</text></view>
      <view class="info-row"><text>手机号</text><text>{{profile.phoneText}}</text></view>
      <view class="info-row column"><text>技能标签</text><view><text class="tag" wx:for="{{selectedSkills}}" wx:key="*this">{{item}}</text></view></view>
      <view class="info-row column"><text>可服务时间</text><text>{{profile.availableTimeText}}</text></view>
      <view class="info-row column"><text>个人简介</text><text>{{profile.bioText}}</text></view>
    </view>

    <view wx:else>
      <input placeholder="昵称" value="{{form.nickname}}" data-key="nickname" bindinput="input" />
      <input placeholder="学院" value="{{form.college}}" data-key="college" bindinput="input" />
      <picker mode="selector" range="{{campusOptions}}" bindchange="pickCampus">
        <view class="profile-picker">所在校区：{{form.campus || '请选择'}}</view>
      </picker>
      <picker mode="selector" range="{{departmentOptions}}" bindchange="pickDepartment">
        <view class="profile-picker">所属系：{{form.department || '请选择'}}</view>
      </picker>
      <input placeholder="专业班级" value="{{form.majorClass}}" data-key="majorClass" bindinput="input" />
      <input placeholder="手机号" value="{{form.phone}}" data-key="phone" bindinput="input" />
      <view class="skill-grid">
        <view wx:for="{{skillOptions}}" wx:key="name" class="skill {{item.selected ? 'active' : ''}}" data-skill="{{item.name}}" bindtap="toggleSkill">{{item.name}}</view>
      </view>
      <textarea placeholder="可服务时间" value="{{form.availableTime}}" data-key="availableTime" bindinput="input"></textarea>
      <textarea placeholder="个人简介" value="{{form.bio}}" data-key="bio" bindinput="input"></textarea>
    </view>
  </view>

  <view class="section" wx:if="{{!isAdmin}}">
    <view class="section-head">
      <view class="section-title no-margin">课程安排</view>
      <button class="mini-add" bindtap="addCourse">添加</button>
    </view>
    <view class="exam-tip">课程会按每周固定时间参与活动报名冲突检测。上传课表后请核对AI识别结果。</view>
    <button class="schedule-upload" bindtap="uploadScheduleImage" loading="{{parsingSchedule}}">上传课表图片并AI识别</button>
    <view class="exam-card" wx:for="{{courses}}" wx:key="index">
      <input placeholder="课程名称" value="{{item.courseName}}" data-index="{{index}}" data-key="courseName" bindinput="inputCourse" />
      <picker mode="selector" range="{{weekdayOptions}}" value="{{item.weekday - 1}}" data-index="{{index}}" bindchange="pickCourseWeekday">
        <view class="course-picker">上课日期：{{item.weekdayText}}</view>
      </picker>
      <view class="course-time-row">
        <picker mode="time" value="{{item.startTime}}" data-index="{{index}}" data-key="startTime" bindchange="pickCourseTime">
          <view class="course-picker">{{item.startTime || '开始时间'}}</view>
        </picker>
        <picker mode="time" value="{{item.endTime}}" data-index="{{index}}" data-key="endTime" bindchange="pickCourseTime">
          <view class="course-picker">{{item.endTime || '结束时间'}}</view>
        </picker>
      </view>
      <input placeholder="上课地点（选填）" value="{{item.location}}" data-index="{{index}}" data-key="location" bindinput="inputCourse" />
      <button class="exam-remove" data-index="{{index}}" bindtap="removeCourse">删除</button>
    </view>
    <view wx:if="{{courses.length === 0}}" class="empty-badge">暂未填写课程安排</view>
    <button class="reminder-btn" bindtap="saveCourses">保存课程安排</button>
  </view>

  <view class="section" wx:if="{{!isAdmin}}">
    <view class="section-head">
      <view class="section-title no-margin">考试安排</view>
      <button class="mini-add" bindtap="addExam">添加</button>
    </view>
    <view class="exam-tip">用于报名时检测岗位与考试时间冲突，格式：2026-06-25 14:00</view>
    <view class="exam-card" wx:for="{{exams}}" wx:key="index">
      <input placeholder="课程名称" value="{{item.courseName}}" data-index="{{index}}" data-key="courseName" bindinput="inputExam" />
      <input placeholder="开始时间：2026-06-25 14:00" value="{{item.startTime}}" data-index="{{index}}" data-key="startTime" bindinput="inputExam" />
      <input placeholder="结束时间：2026-06-25 16:00" value="{{item.endTime}}" data-index="{{index}}" data-key="endTime" bindinput="inputExam" />
      <input placeholder="考试地点（选填）" value="{{item.location}}" data-index="{{index}}" data-key="location" bindinput="inputExam" />
      <button class="exam-remove" data-index="{{index}}" bindtap="removeExam">删除</button>
    </view>
    <view wx:if="{{exams.length === 0}}" class="empty-badge">暂未填写考试安排</view>
    <button class="reminder-btn" bindtap="saveExams">保存考试安排</button>
  </view>

  <view class="section" wx:if="{{!isAdmin}}">
    <view class="section-title">活动提醒设置</view>
    <view class="reminder-status">{{subscriptionEnabled ? '已开启关注类型提醒' : '未开启活动提醒'}}</view>
    <view class="reminder-channel">
      <text>微信提醒</text>
      <switch checked="{{wechatReminderEnabled}}" bindchange="toggleWechatReminder" color="#0f766e" />
    </view>
    <view class="reminder-channel">
      <text>邮箱提醒</text>
      <switch checked="{{emailReminderEnabled}}" bindchange="toggleEmailReminder" color="#0f766e" />
    </view>
    <input wx:if="{{emailReminderEnabled}}" class="email-input" placeholder="请输入接收提醒的邮箱" value="{{reminderEmail}}" bindinput="inputReminderEmail" />
    <view class="custom-category-row">
      <input class="category-input" placeholder="自定义活动方向" value="{{customActivityCategory}}" bindinput="inputCustomActivityCategory" confirm-type="done" bindconfirm="addActivityCategory" />
      <button class="category-add-btn" bindtap="addActivityCategory">添加</button>
    </view>
    <view class="category-grid">
      <view wx:for="{{activityCategoryOptions}}" wx:key="name" class="category-option {{item.selected ? 'active' : ''}}" data-category="{{item.name}}" bindtap="toggleActivityCategory">{{item.name}}</view>
    </view>
    <button class="reminder-btn" bindtap="saveActivityReminder">保存并订阅微信提醒</button>
  </view>

  <view class="actions">
    <button wx:if="{{isAdmin && !editing}}" class="primary-btn" bindtap="goAdmin">管理后台</button>
    <button wx:if="{{!isAdmin && !editing}}" class="ghost-btn" bindtap="myRegs">我的报名</button>
    <button wx:if="{{!isAdmin && !editing}}" class="ghost-btn" bindtap="myEvaluations">我的评价</button>
    <button wx:if="{{!isAdmin && !editing}}" class="ghost-btn" bindtap="growthProfile">成长档案</button>
    <button wx:if="{{!editing}}" class="ghost-btn" bindtap="goReport">AI服务报告</button>
    <button wx:if="{{!editing}}" class="primary-btn" bindtap="startEdit">编辑资料</button>
    <button wx:if="{{editing}}" class="ghost-btn" bindtap="cancelEdit">取消</button>
    <button wx:if="{{editing}}" class="primary-btn" bindtap="saveProfile">保存资料</button>
  </view>
  <button class="logout-btn" bindtap="logout">退出登录</button>
</view>
